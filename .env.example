# ============================================================
# TriadFlow Multi-Agent System - Environment Configuration
# ============================================================

# --- Primary LLM Engine (Google Gemini) ---
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Authentication & JWT Security ---
# Secret key used to sign stateless JWT bearer tokens (generate with `openssl rand -hex 32`)
JWT_SECRET=super-secret-triadflow-multiagent-jwt-key-2026

# --- Outbound Email Authentication (SMTP Service) ---
# To receive genuine 6-digit OTP codes directly in your email inbox, configure your SMTP provider below.
#
# Quick Setup for Gmail:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your gmail and the 16-character App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_FROM_NAME=TriadFlow Security
SMTP_FROM_EMAIL=your_email@gmail.com

# --- Optional External Search APIs (Fallbacks to high-speed DuckDuckGo Lite if omitted) ---
# TAVILY_API_KEY=tvly-...
# SERPER_API_KEY=...

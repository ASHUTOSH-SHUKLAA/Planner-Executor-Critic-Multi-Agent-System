# ==============================================================================
# Synora Production Environment Configuration
# ==============================================================================
# Architecture:
# - Next.js Frontend: Vercel (https://*.vercel.app)
# - FastAPI Backend: Render Web Service (https://synora-backend.onrender.com)
# - Multi-Agent Engine: Render Background Worker
# - Relational DB: Render Postgres (PostgreSQL 16 - Free Tier Available)
# - Job Queue / Cache: Render Key Value (Redis 7+ - Free Tier Available)
# - File Storage: On-the-fly In-Memory PDF generation / Local fallback (No AWS S3 required)
# ==============================================================================

# --- 1. Primary LLM Engine (Google Gemini) ---
# Obtain your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- 2. Authentication & JWT Security ---
# Secret key used to sign stateless JWT bearer tokens (generate with `openssl rand -hex 32`)
JWT_SECRET=generate-a-secure-random-32-byte-hex-string-for-production

# --- 2.1 Google OAuth 2.0 / Google Sign-In (Optional but Recommended) ---
# Create credentials in Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# Authorized JavaScript Origins: http://localhost:3000, https://synora.vercel.app, https://*.vercel.app
# Authorized Redirect URIs: http://localhost:3000/api/auth/callback/google, https://synora.vercel.app
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Also add to Vercel environment variables as NEXT_PUBLIC_GOOGLE_CLIENT_ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- 3. Relational Database (Render Postgres) ---
# NOTE ON SQLITE VS POSTGRESQL IN PRODUCTION:
# SQLite stores data in a local file (app.db). On cloud container platforms like Render,
# containers are ephemeral: local disk files are WIPED upon every deploy or restart.
# Furthermore, SQLite locks when multiple processes (FastAPI Web + Background Worker) write simultaneously.
# Render provides a FREE PostgreSQL 16 database tier that solves both issues with persistent storage.
# Format: postgresql://user:password@host:port/database_name
# If DATABASE_URL is unset, Synora falls back to local SQLite (app.db) for local testing.
DATABASE_URL=postgresql://synora_user:synora_secure_pass@dpg-xxxxxx-a.oregon-postgres.render.com/synora_db

# --- 4. Redis Job Queue & Cache (Render Key Value) ---
# Render Key Value internal connection string for async task dispatch & SSE pub/sub.
# Format: redis://red-xxxxxx:6379 or rediss://...
# If unset, Synora operates in local in-process mode.
REDIS_URL=redis://red-xxxxxx:6379

# --- 5. CORS & Domain Whitelisting ---
# Comma-separated list of allowed origins. Wildcards (*) are disabled in production for JWT security.
# Vercel preview domains (https://*.vercel.app) are automatically matched via regex in src/api/main.py.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://synora.vercel.app
FRONTEND_URL=https://synora.vercel.app

# --- 6. Frontend Environment Variables (Vercel Project Settings) ---
# Configure in Vercel Dashboard > Project Settings > Environment Variables:
NEXT_PUBLIC_API_URL=https://synora-backend.onrender.com

# --- 7. Outbound Email Verification (SMTP Service) ---
# To receive genuine 6-digit OTP codes directly in your email inbox, configure your SMTP provider below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_NAME=Synora
SMTP_FROM_EMAIL=your_email@gmail.com

# --- 8. Optional External Search Engines (Fallbacks to high-speed DuckDuckGo Lite if omitted) ---
# TAVILY_API_KEY=tvly-...
# SERPER_API_KEY=...
